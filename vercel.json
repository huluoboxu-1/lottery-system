{
    "version": 2,
    "name": "lottery-system",
    "installCommand": "pip install -r requirements.txt",
    "buildCommand": "echo 'Build complete'",
    "builds": [
        {
            "src": "app.py",
            "use": "@vercel/python"
        }
    ],
    "routes": [
        {
            "src": "/(.*)",
            "dest": "app.py"
        }
    ]
}
