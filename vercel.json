{
        "version": 2,
        "name": "lottery-system",
        "builds": [
            {
                "src": "app.py",
                "use": "@vercel/python",
                "config": {
                    "runtime": "python3.9",
                    "maxLambdaSize": "25mb",
                    "wsgiEntrypoint": "app:application"
                }
            }
        ],
        "routes": [
            { "src": "/(.*)", "dest": "app.py" }
        ],
        "functions": {
            "app.py": {
                "maxDuration": 10
            }
        }
    }
    